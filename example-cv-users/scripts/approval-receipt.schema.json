{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local one-shot session/recovery approval receipt",
  "type": "object",
  "required": [
    "schema",
    "policy",
    "authorization",
    "approvalReference",
    "candidateSha256",
    "toolingSha256",
    "batchId",
    "project",
    "uidSha256",
    "scope",
    "batchExpiresAt",
    "issuedAt",
    "expiresAt",
    "userApproval"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "policy": {
      "enum": [
        "session-live-read-receipt-v1",
        "recovery-live-read-receipt-v1",
        "recovery-manual-dashboard-receipt-v1"
      ]
    },
    "authorization": {
      "const": "USER_APPROVED"
    },
    "approvalReference": {
      "type": "string",
      "pattern": "^S2-APPROVAL-[A-Za-z0-9-]{16,100}$"
    },
    "candidateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "toolingSha256": {
      "$ref": "#/$defs/sha256"
    },
    "uidSha256": {
      "$ref": "#/$defs/sha256"
    },
    "liveReadSha256": {
      "$ref": "#/$defs/sha256"
    },
    "batchId": {
      "type": "string"
    },
    "project": {
      "const": "makwjnbubmrmopjhzror"
    },
    "batchExpiresAt": {
      "type": "integer"
    },
    "issuedAt": {
      "type": "integer"
    },
    "expiresAt": {
      "type": "integer"
    },
    "scope": {
      "type": "object",
      "required": [
        "operations",
        "maxUpstreamTotal",
        "identityRequests",
        "maxUpstreamRequests",
        "maxEmails",
        "runLeaseMaxMs"
      ],
      "properties": {
        "operations": {
          "enum": [
            [
              "passwordLogin",
              "refresh",
              "localLogout",
              "getUser",
              "jwks"
            ],
            [
              "recover",
              "verifyRecovery",
              "passwordUpdate",
              "passwordLogin",
              "localLogout",
              "getUser",
              "jwks"
            ]
          ]
        },
        "maxUpstreamTotal": {
          "enum": [
            36,
            18
          ]
        },
        "identityRequests": {
          "enum": [
            28,
            10
          ]
        },
        "maxEmails": {
          "enum": [
            0,
            2
          ]
        },
        "runLeaseMaxMs": {
          "const": 1800000
        }
      }
    },
    "userApproval": {
      "type": "object",
      "required": [
        "source",
        "candidateSha256",
        "reference"
      ],
      "properties": {
        "source": {
          "const": "USER_CHAT_EXPLICIT_APPROVAL"
        },
        "candidateSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manualEvidenceSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$comment": "Runtime additionally enforces exact candidate bytes, complete quotas/UID/project/tool binding, LIVE_READ checks and 60-minute age, receipt 60-minute maximum, independent run lease <=30 minutes, candidate at most 12 hours (R03 may retain an earlier cutoff), certificate 60-minute margin, one O_EXCL claim and process-local single executor capability. No production receipt is generated by tests or preparation. Recovery policy requires account A, recovery-only-v1, exact 18/10 caps via validateBatch; binds password stages/template plan and fresh live evidence proving the temporary code body installed. Runtime enforces profile-specific combinations. Manual recovery policy is allowed only for the exact R-02 or R-03 ID and the bound project/UID. Source MANUAL_DASHBOARD_RECHECK is never LIVE_READ. Runtime verifies raw UTF-8 exports, separate config records and user attestations, candidate/tool hashes, timestamps and subject/body pairs before the same atomic claim.",
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "recovery-manual-dashboard-receipt-v1"
          }
        }
      },
      "then": {
        "required": [
          "manualEvidenceSha256"
        ],
        "not": {
          "required": [
            "liveReadSha256"
          ]
        }
      },
      "else": {
        "required": [
          "liveReadSha256"
        ],
        "not": {
          "required": [
            "manualEvidenceSha256"
          ]
        }
      }
    }
  ]
}
