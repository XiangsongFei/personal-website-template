{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "example-cv-users",
  "main": "worker/index.ts",
  // Maximum supported date of the existing pinned workerd, not an upgrade.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "durable_objects": { "bindings": [{ "name": "USERS_RECOVERY_STATE", "class_name": "RecoveryState" }] },
  "migrations": [{ "tag": "users-v1", "new_sqlite_classes": ["RecoveryState"] }],
  "cache": { "enabled": false },
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "USERS_MODE": "disabled",
    "USERS_CURRENT_PASSWORD_POLICY": "UNVERIFIED",
    "USERS_PROJECT_REF": "makwjnbubmrmopjhzror",
    "USERS_SUPABASE_URL": "https://makwjnbubmrmopjhzror.supabase.co",
    "USERS_APP_ORIGIN": "https://admin.example-cv.com"
  },
  "observability": { "enabled": false }
}
