{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "tsBuildInfoFile": ".runtime/typescript.tsbuildinfo"
  },
  "include": [
    "app/**/*",
    "lib/**/*",
    "worker/**/*",
    "vite.config.ts",
    "next.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".runtime"
  ]
}
